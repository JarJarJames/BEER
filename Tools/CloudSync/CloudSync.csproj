<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SteamKit2" Version="3.4.0" />
  </ItemGroup>

  <!-- The SwiftPM prebuild plugin moves obj/ and bin/ into its own work
       directory, which drops them from the SDK's default excludes. Without
       this, files a plain `dotnet build` left in obj/ get compiled twice. -->
  <ItemGroup>
    <Compile Remove="bin/**;obj/**;publish/**" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CloudSync.Tests" />
  </ItemGroup>

</Project>
